{
  "permissions": {
    "allow": [
      "mcp__mtg__bulk_card_lookup",
      "mcp__mtg__scryfall_card_details",
      "mcp__mtg__edhrec_card_synergy",
      "mcp__mtg__scryfall_search_cards",
      "mcp__mtg__rules_lookup",
      "mcp__mtg__deck_validate",
      "mcp__mtg__deck_analysis",
      "mcp__mtg__spellbook_find_decklist_combos",
      "mcp__mtg__scryfall_card_rulings",
      "mcp__mtg__spellbook_find_combos",
      "mcp__mtg__price_comparison",
      "mcp__mtg__spellbook_estimate_bracket",
      "Bash(uvx ruff check .)",
      "Bash(uvx ruff format --check .)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; if echo \"$f\" | grep -qE '(^|/)\\.env$'; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Do not edit .env directly. Use .env.example instead.\"}}'; fi; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; [ -n \"$f\" ] && echo \"$f\" | grep -qE '\\.py$' && ruff format --quiet \"$f\"; } 2>/dev/null || true",
            "statusMessage": "Formatting..."
          }
        ]
      }
    ]
  }
}
